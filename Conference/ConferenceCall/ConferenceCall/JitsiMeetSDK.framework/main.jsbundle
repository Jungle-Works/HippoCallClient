628\u0627\u0644\u0641\u064a\u062f\u064a\u0648. \u064a\u0631\u062c\u0649 \u0645\u0646\u062d\u0647 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a",permissionErrorTitle:"\u0627\u0644\u0625\u0630\u0646 \u0645\u0637\u0644\u0648\u0628",permissionMicRequiredError:"\u0645\u0637\u0644\u0648\u0628 \u0625\u0630\u0646 \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0644\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a \u0627\u0644\u0645\u0624\u062a\u0645\u0631\u0627\u062a \u0645\u0639 \u0627\u0644\u0635\u0648\u062a. \u064a\u0631\u062c\u0649 \u0645\u0646\u062d\u0647 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a",popupError:"\u064a\u0645\u0646\u0639 \u0645\u062a\u0635\u0641\u062d\u0643 \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639. \u0641\u0639\u0651\u0650\u0644 \u0631\u062c\u0627\u0621\u064b \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",popupErrorTitle:"\u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629 \u0645\u062d\u062c\u0648\u0628\u0629.",readMore:"\u0623\u0643\u062b\u0631",recentlyUsedObjects:"\u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0645\u0624\u062e\u0631\u064b\u0627",recording:"\u0642\u064a\u062f \u0627\u0644\u062a\u0633\u062c\u064a\u0644",recordingDisabledBecauseOfActiveLiveStreamingTooltip:"\u0644\u064a\u0633 \u0628\u0627\u0644\u0625\u0645\u0643\u0627\u0646 \u0645\u0627 \u062f\u0645\u062a \u0642\u064a\u062f \u0627\u0644\u0628\u062b \u0627\u0644\u0645\u0628\u0627\u0634\u0631",recordingDisabledTooltip:"\u0639\u0645\u0644\u064a