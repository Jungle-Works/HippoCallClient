\u0648\u0627\u0646 \u0644\u0625\u0635\u0644\u0627\u062d \u0647\u0630\u0647 \u0627\u0644\u0645\u0634\u0643\u0644\u0629.",micTimeoutError:"\u062a\u0639\u0630\u0631 \u0628\u062f\u0621 \u0645\u0635\u062f\u0631 \u0627\u0644\u0635\u0648\u062a. \u0627\u0646\u0642\u0636\u062a \u0627\u0644\u0645\u0647\u0644\u0629!",micUnknownError:"\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0644\u0633\u0628\u0628 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641.",moderationAudioLabel:"\u0627\u0644\u0633\u0645\u0627\u062d \u0644\u0644\u062d\u0627\u0636\u0631\u064a\u0646 \u0628\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u0648\u062a \u0628\u0623\u0646\u0641\u0633\u0647\u0645",moderationVideoLabel:"\u0627\u0644\u0633\u0645\u0627\u062d \u0644\u0644\u062d\u0627\u0636\u0631\u064a\u0646 \u0628\u0628\u062f\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u0645",muteEveryoneDialog:"\u0623\u0645\u062a\u0623\u0643\u062f \u0645\u0646 \u0631\u063a\u0628\u062a\u0643 \u0628\u0643\u062a\u0645 \u0627\u0644\u062c\u0645\u064a\u0639\u061f \u0644\u0646 \u062a\u062a\u0645\u0643\u0646 \u0645\u0646 \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0643\u062a\u0645 \u0648\u0644\u0643\u0646 \u064a\u0645\u0643\u0646\u0647\u0645 \u0625\u0644\u063a\u0627\u0621 \u0643\u062a\u0645 \u0623\u0646\u0641\u0633\u0647\u0645 \u0641\u064a \u0623\u064a \u0648\u0642\u062a.",muteEveryoneDialogModerationOn:"\u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0634\u0627\u0631\u0643\u064a\u0646 \u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628 \u0644\u0644\u062a\u062d\u062f\u062b \u0641\u064a \u0623\u064a \u0648\u0642\u062a.",muteEveryoneElseDialog:"\u0628\u0645\u062c\u0631\u062f \u0623\u0646 \u062a\u0643\u062a\u0645\u0647\u0645\u060c \u0644\u0646 \u062a\u062a\u0645\u0643\u0646 \u0646\u0645 \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0643\u062a\u0645 \u0647\u0630\u0627\u060c \u0648\u0644\u0643\u0646